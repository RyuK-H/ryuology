---
import type { RelatedLink } from '../lib/related';

interface Props {
  links: RelatedLink[];
}

const { links } = Astro.props;
---

<nav class="next-reads" aria-label="다음 읽을 글">
  {links.length > 0 && <h2>다음 읽을 글</h2>}
  {
    links.length > 0 && (
      <ul class="cards">
        {links.map((link) => (
          <li>
            <a href={link.href}>
              <span class="kicker">{link.kicker}</span>
              <span class="title">{link.title}</span>
              {link.why && <span class="why">{link.why}</span>}
            </a>
          </li>
        ))}
      </ul>
    )
  }
  {/* 최종 안전망 — 추천이 한 장도 없어도(발행 직후 계보 미연결) 여기서 막히지 않게. */}
  {/* 추천 카드보다 한 톤 낮춘다: 목록으로 되돌아가는 게 이 기능이 막으려던 동선이라 같은 무게로 권하지 않는다. */}
  <ul class="exits">
    <li>
      <a href="/posts/">← 글 목록으로 돌아가기</a>
    </li>
    <li>
      <a href="/map/">사고 지도에서 이 글의 자리 보기 →</a>
    </li>
  </ul>
</nav>

<style>
  .next-reads {
    margin-top: 3rem;
  }
  .next-reads h2 {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--muted);
    margin: 0 0 0.75rem;
    letter-spacing: 0.02em;
  }
  .next-reads .cards {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .next-reads .cards a {
    display: block;
    padding: 0.875rem 1rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
  }
  .next-reads .cards a:hover {
    border-color: var(--accent);
  }
  .kicker {
    display: block;
    font-size: 0.75rem;
    color: var(--muted);
    margin-bottom: 0.25rem;
  }
  .title {
    display: block;
    font-weight: 600;
    font-size: 1rem;
  }
  .next-reads .cards a:hover .title {
    color: var(--accent);
  }
  .exits {
    list-style: none;
    padding: 0;
    margin: 0.625rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .exits a {
    display: block;
    white-space: nowrap;
    padding: 0.625rem 0.875rem;
    border: 1px dashed var(--border);
    border-radius: 10px;
    color: var(--muted);
    font-size: 0.875rem;
    text-decoration: none;
  }
  .exits a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  /* why는 사고 지도 엣지의 문장을 그대로 쓴다 — 길면 다듬지 않고 2행에서 자른다 */
  .why {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }
</style>
