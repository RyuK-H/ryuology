---
import type { Post } from '../lib/posts';
import { formatDate } from '../lib/posts';
import { AUTHOR_EMOJI } from '../site';

interface Props {
  posts: Post[];
  // 연도 헤딩 아래에 놓일 때는 날짜에서 연도를 뺀다 (/posts/ 목록)
  hideYear?: boolean;
}

const { posts, hideYear = false } = Astro.props;

// data-* 는 /posts/의 칩 필터가 클라이언트에서 읽는다. 다른 페이지에선 그냥 안 쓰인다.
---

<ul class="post-list">
  {
    posts.map((post) => (
      <li data-tags={post.data.tags.join(',')}>
        <a href={`/posts/${post.id}/`}>
          <span class="author-emoji">{AUTHOR_EMOJI[post.data.author] ?? ''}</span> {post.data.title}
        </a>
        <time datetime={post.data.pubDate.toISOString()}>
          {hideYear ? formatDate(post.data.pubDate).slice(5) : formatDate(post.data.pubDate)}
        </time>
        <p>{post.data.description}</p>
      </li>
    ))
  }
</ul>

<style>
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .post-list li {
    margin-bottom: 1.75rem;
  }
  .post-list a {
    font-weight: 600;
    font-size: 1.125rem;
    text-decoration: none;
  }
  .post-list a:hover {
    text-decoration: underline;
  }
  .post-list time {
    margin-left: 0.5rem;
    color: var(--muted);
    font-size: 0.875rem;
  }
  .post-list p {
    margin: 0.25rem 0 0;
    color: var(--muted);
    font-size: 0.9375rem;
  }
</style>
