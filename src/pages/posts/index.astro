---
import Base from '../../layouts/Base.astro';
import PostBrowser from '../../components/PostBrowser.astro';
import { getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();
---

<Base title="글">
  <div class="head">
    <h1>글</h1>
    <span class="count" data-count>{posts.length}편</span>
  </div>
  <PostBrowser posts={posts} />
</Base>

<style>
  .head {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
  }
  .count {
    color: var(--muted);
    font-size: 0.875rem;
  }
</style>
