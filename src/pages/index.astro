---
import Base from '../layouts/Base.astro';
import PostBrowser from '../components/PostBrowser.astro';
import { SITE } from '../site';
import { getPublishedPosts } from '../lib/posts';

// 홈과 /posts/는 같은 목록을 보여준다 — 차이는 위의 소개 두 줄뿐.
// 방문자가 습관적으로 홈으로 오는데 목록·필터가 /posts/에만 있으면 그 작업이 안 보인다.
const posts = await getPublishedPosts();
---

<Base>
  <p class="mission">
    AI가 콘텐츠를 쏟아내는 시대에, <span class="hl">사람이 직접 겪고 쓴 기록.</span>
  </p>
  <p class="tagline">// {SITE.tagline} — 개발자 류기혁의 개인 블로그</p>
  <h2 class="listhead">
    <span class="c">▸</span> 글 <span class="count" data-count>{posts.length}편</span>
  </h2>
  <PostBrowser posts={posts} />
</Base>

<style>
  .mission {
    font-size: 1.05rem;
    margin: 1rem 0 0.35rem;
    max-width: 36rem;
    line-height: 1.65;
  }
  .mission .hl {
    color: var(--amber);
  }
  .tagline {
    color: var(--muted);
    font-size: 0.85rem;
    margin: 0;
  }
  .listhead {
    font-size: 1.05rem;
    color: var(--accent);
    letter-spacing: 0.02em;
    margin: 2.4rem 0 1.2rem;
  }
  .listhead .c {
    color: var(--faint);
  }
  .listhead .count {
    color: var(--muted);
    font-size: 0.875rem;
    font-weight: 400;
  }
</style>
